# Copia este archivo a .env.local y completa los valores. .env.local nunca se sube al repo.

# Sin Supabase, el sitio usa los datos de EJEMPLO y guarda los leads en memoria.
# En producción (VERCEL_ENV=production, o APP_ENV=production fuera de Vercel) todo es obligatorio.
# APP_ENV=production

# --- Públicas (viajan al navegador) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Solo dígitos, con código de país. Valor de ejemplo, no es un número real.
NEXT_PUBLIC_WHATSAPP_NUMBER=50400000000
# "true" solo en producción y después del lanzamiento. Mientras tanto el sitio no se indexa.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secretas (solo servidor; nunca con prefijo NEXT_PUBLIC_) ---
# Llave service role (o "secret key") de Supabase: acceso total a la base.
SUPABASE_SERVICE_ROLE_KEY=
# Sal para anonimizar IPs en el rate limiting. Genera una con: openssl rand -hex 32
RATE_LIMIT_SALT=

# Correos (Resend). Sin esto, en desarrollo los correos solo se anuncian en la consola.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej. "ConstruFácil <hola@tudominio.com>"
EMAIL_FROM=
# Buzón de ventas que recibe cada lead.
LEADS_NOTIFICATION_EMAIL=

# Fase 3: pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Solo para tests de RLS (Postgres local, sin datos reales) ---
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
